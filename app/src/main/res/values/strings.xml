    <string name="lock_set">Définir le code</string>
    <string name="lock_change">Modifier le code</string>
    <string name="lock_remove">Retirer le code</string>
    <string name="lock_remove_body">Sans code, tout redevient modifiable librement.</string>
    <string name="lock_new_intro">À saisir par le proche, idéalement hors de ta vue.</string>
    <string name="lock_new_pin">Nouveau code (4 à 8 chiffres)</string>
    <string name="lock_confirm_pin">Confirmer le code</string>
    <string name="lock_invalid">Le code doit compter 4 à 8 chiffres.</string>
    <string name="lock_mismatch">Les deux codes ne correspondent pas.</string>
    <string name="lock_saved">Code enregistré. Les modifications restent possibles pendant 5 min.</string>
    <string name="lock_removed">Code retiré.</string>
    <string name="lock_protects_settings">Tant que le code est défini, les écrans des Paramètres qui permettraient de couper Mobile Manager (infos de l\'app, accessibilité, désinstallation) se referment, sauf pendant les 5 minutes qui suivent la saisie du code.</string>
    <string name="lock_forgot">En cas d\'oubli, seule la désinstallation de l\'app permet de repartir de zéro (toutes les règles sont alors perdues).</string>
    <string name="lock_limits">Comme le reste, le code ajoute de la friction sans verrouiller le téléphone : le mode sans échec ou un ordinateur permettent toujours de passer outre.</string>
    <string name="protected_screen_locked">Protégé par le code du proche</string>

    <!-- Zones et quotas -->
    <string name="zones_title">Zones et quotas</string>
    <string name="zones_entry_body">Reels, Shorts : bloqués ou limités chaque jour</string>
    <string name="zones_intro">Agit seulement sur une partie d\'une app : la messagerie et les publications d\'Instagram restent accessibles. Bloquée : le bouton est masqué et la zone quittée automatiquement. Quota : temps cumulé par jour, puis c\'est fini jusqu\'à minuit.</string>
