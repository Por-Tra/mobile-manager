    <!-- Code du proche -->
    <string name="lock_title">Code du proche</string>
    <string name="lock_entry_body_off">Aucun code : tout est modifiable</string>
    <string name="lock_entry_body_on">Défini : modifier les restrictions demande le code</string>
    <string name="lock_intro">Un proche choisit un code de 4 à 8 chiffres. Ensuite, modifier les profils, les règles par défaut, les zones et quotas, les détecteurs ou l\'objectif demande ce code. Démarrer une session de concentration ou activer un profil reste libre.</string>
