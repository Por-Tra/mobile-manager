    <string name="restricted_settings_title">Le service est grisé ?</string>
    <string name="restricted_settings_body">Android limite les apps installées hors Play Store. Ouvre « Infos de l\'application », touche le menu ⋮ en haut à droite puis « Autoriser les paramètres restreints ». Reviens ensuite activer le service.</string>
    <string name="restricted_settings_action">Ouvrir les infos de l\'app</string>

    <string name="samsung_battery_title">Réglage Samsung conseillé</string>
    <string name="samsung_battery_body">Dans Paramètres › Batterie › Limites d\'utilisation en arrière-plan, ajoute Mobile Manager aux « Applis jamais en veille ». Sinon One UI peut arrêter la surveillance.</string>
    <string name="samsung_battery_action">Ouvrir les paramètres de batterie</string>

