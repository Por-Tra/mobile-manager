    <string name="permission_accessibility_title">Service d\'accessibilité</string>
    <string name="permission_accessibility_body">Permet de savoir quelle app est ouverte et de renvoyer vers l\'accueil quand elle est bloquée.</string>
    <string name="permission_usage_stats_title">Accès aux statistiques d\'utilisation</string>
