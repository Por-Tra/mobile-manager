    <string name="app_name">Mobile Manager</string>

    <string name="accessibility_service_label">Surveillance Mobile Manager</string>
    <string name="accessibility_service_description">Détecte l\'application au premier plan pour appliquer tes règles de blocage. Pendant une session de concentration, lit aussi les textes des écrans des Paramètres pour protéger la session. Jamais le contenu de tes messages ou publications. Aucune donnée ne quitte le téléphone.</string>
    <string name="device_admin_explanation">L\'administration de l\'appareil ajoute une étape avant la désinstallation pendant le mode strict. Elle ne donne aucun autre pouvoir à l\'app.</string>

